APP_NAME="Pokemon Battle Bets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pokebet
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pokebet.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PokéAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_IMPORT_LIMIT=2000
POKEAPI_IMPORT_DELAY_MS=150

# Battle config
BATTLE_MAX_LEVEL_DIFF=4
BATTLE_MIN_LEVEL=5
BATTLE_MAX_LEVEL=100
BATTLE_CRITICAL_CHANCE=0.0625
BATTLE_CRITICAL_MULTIPLIER=1.5
BATTLE_RANDOM_DAMAGE_MIN=0.85
BATTLE_RANDOM_DAMAGE_MAX=1.00

# Economy
ECONOMY_STARTING_COINS=1000
ECONOMY_WIN_REWARD_MIN=50
ECONOMY_WIN_REWARD_MAX=150
ECONOMY_LOSS_REWARD=10

# Pokémon images
POKEMON_IMAGE_FALLBACK=/images/pokemon-placeholder.png
